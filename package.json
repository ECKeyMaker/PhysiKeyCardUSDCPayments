{
  "name": "PhysiKeyCard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "bundle:ios": "react-native bundle --entry-file index.js --platform ios --dev false --bundle-output ios/main.jsbundle --assets-dest ios",
    "postinstall": "patch-package && npm run bundle:ios",
    "base:sepolia": "node start.js testnet && react-native start --reset-cache",
    "base:mainnet": "node start.js mainnet && react-native start --reset-cache",
    "build:android:base:sepolia": "node start.js testnet && react-native build-android --mode=release",
    "build:android:base:mainnet": "node start.js mainnet && react-native build-android --mode=release",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/blur": "^4.4.0",
    "@react-native-masked-view/masked-view": "^0.3.1",
    "@react-native/codegen": "^0.74.84",
    "@react-navigation/material-top-tabs": "^6.6.13",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.3.29",
    "crypto-js": "^4.2.0",
    "emoji-regex": "^10.3.0",
    "expo-modules-core": "^1.12.15",
    "fetch": "^1.1.0",
    "hermes-engine": "^0.11.0",
    "node-fetch": "^3.3.2",
    "node-libs-browser": "^0.7.0",
    "permissionless": "0.2.56",
    "randomstring": "^1.3.0",
    "react": "18.2.0",
    "react-native": "^0.74.2",
    "react-native-argon2": "^2.0.1",
    "react-native-crypto-js": "^1.0.0",
    "react-native-dotenv": "^3.4.11",
    "react-native-gesture-handler": "^2.17.1",
    "react-native-haptic-feedback": "^2.2.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-keychain": "^8.2.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-modal": "^13.0.1",
    "react-native-nfc-manager": "^3.15.0",
    "react-native-pager-view": "^6.3.3",
    "react-native-paper": "^5.12.3",
    "react-native-randombytes": "^3.6.1",
    "react-native-reanimated": "^3.15.1",
    "react-native-reanimated-carousel": "^3.5.1",
    "react-native-safe-area-context": "^4.10.5",
    "react-native-screens": "^3.32.0",
    "react-native-securerandom": "^1.0.1",
    "react-native-tab-view": "^3.5.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-walkthrough-tooltip": "^1.6.0",
    "react-native-webview": "^13.10.5",
    "viem": "~2.28.1",
    "web3": "^4.10.0",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.74.84",
    "@react-native/eslint-config": "0.74.84",
    "@react-native/metro-config": "0.74.84",
    "@react-native/typescript-config": "0.74.84",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "hash-wasm": "^4.12.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.0",
    "prettier": "2.8.8",
    "react-native-codegen": "^0.70.7",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "description": "Open-source React Native app that turns low-cost NFC tags into cold-storage key cards for a USDC wallet on Base.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_ORG/PhysiKeyCard.git"
  }
}
