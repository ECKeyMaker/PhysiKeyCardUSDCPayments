# Copy this file to .env.mainnet and replace the YOUR_... placeholders.
# .env.mainnet is gitignored so your real keys are never committed.
# MAIN NET
CHAIN_ID="8453"
BASE_USDC_CONTRACT="0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
ACCOUNT_FACTORY_ADDRESS="0x91E60e0613810449d098b0b5Ec8b51A0FE8c8985"
RPC_URL="https://mainnet.base.org"
WEB3_URL="https://mainnet.base.org"
# Transaction history: free Blockscout API by default. Set ETHERSCAN_API_KEY to use
# Etherscan V2 instead (Etherscan requires a paid plan for Base and Base Sepolia).
BLOCKSCOUT_API_URL="https://base.blockscout.com/api"
ETHERSCAN_API_KEY=""
PIMLICO_RPC_URL="https://api.pimlico.io/v2/8453/rpc?apikey=YOUR_PIMLICO_API_KEY"

