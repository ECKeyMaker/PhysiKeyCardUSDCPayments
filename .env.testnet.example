# Copy this file to .env.testnet and replace the YOUR_... placeholders.
# .env.testnet is gitignored so your real keys are never committed.
# TESTNET
CHAIN_ID="84532"
BASE_USDC_CONTRACT="0x036CbD53842c5426634e7929541eC2318f3dCF7e"
ACCOUNT_FACTORY_ADDRESS="0x91E60e0613810449d098b0b5Ec8b51A0FE8c8985"
RPC_URL="https://sepolia.base.org"
# Transaction history: free Blockscout API by default. Set ETHERSCAN_API_KEY to use
# Etherscan V2 instead (Etherscan requires a paid plan for Base and Base Sepolia).
BLOCKSCOUT_API_URL="https://base-sepolia.blockscout.com/api"
ETHERSCAN_API_KEY=""
WEB3_URL="https://sepolia.base.org"
PIMLICO_RPC_URL="https://api.pimlico.io/v2/84532/rpc?apikey=YOUR_PIMLICO_API_KEY"
